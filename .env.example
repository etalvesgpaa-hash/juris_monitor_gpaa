# ═══════════════════════════════════════════════════════════════════════
# JURISMONITOR - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────
# 🗄️ SUPABASE (Obrigatório)
# ─────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# ─────────────────────────────────────────────────────────────────────────
# 📧 EMAIL - GMAIL (Recomendado)
# ─────────────────────────────────────────────────────────────────────────
# Ative esta opção para usar Gmail
USE_GMAIL=true

# Seu e-mail do Gmail
GMAIL_USER=seu-email@gmail.com

# Senha de App do Gmail (16 caracteres sem espaços)
# Gere em: https://myaccount.google.com/apppasswords
# IMPORTANTE: Precisa ter autenticação em 2 fatores ativada!
GMAIL_APP_PASSWORD=abcdefghijklmnop

# ─────────────────────────────────────────────────────────────────────────
# 📧 EMAIL - RESEND (Alternativa/Fallback)
# ─────────────────────────────────────────────────────────────────────────
# API Key do Resend (opcional se usar Gmail)
# Obtenha em: https://resend.com/api-keys
# RESEND_API_KEY=re_sua_chave_aqui

# ─────────────────────────────────────────────────────────────────────────
# 📅 GOOGLE AGENDA (Opcional — sincronização de tarefas/prazos)
# ─────────────────────────────────────────────────────────────────────────
# Crie um projeto em https://console.cloud.google.com, ative a Calendar API
# e gere um "ID do cliente OAuth" do tipo "Aplicativo da Web".
# Configure a URI de redirecionamento como:
#   https://SEU-DOMINIO-NA-VERCEL/api/google-calendar-callback
#
# IMPORTANTE: o Client ID precisa ser configurado DUAS vezes com o mesmo
# valor — uma para o backend (funções em /api) e outra com prefixo VITE_
# para o frontend conseguir montar o link de autorização:
# GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=seu-client-secret

# ─────────────────────────────────────────────────────────────────────────
# 🤖 IA - GROQ (Opcional)
# ─────────────────────────────────────────────────────────────────────────
# Para resumos automáticos de intimações com IA
# Obtenha em: https://console.groq.com/keys
# GROQ_API_KEY=gsk_sua_chave_aqui

# ─────────────────────────────────────────────────────────────────────────
# 🌐 URLS (Opcional)
# ─────────────────────────────────────────────────────────────────────────
# URL do portal do cliente (para links nos emails)
# PORTAL_URL=https://seu-site.vercel.app

# ═══════════════════════════════════════════════════════════════════════
# INSTRUÇÕES
# ═══════════════════════════════════════════════════════════════════════
#
# 1. Copie este arquivo para .env.local:
#    cp .env.example .env.local
#
# 2. Preencha as variáveis com seus valores reais
#
# 3. NUNCA commite o arquivo .env.local no Git!
#
# 4. Para produção (Vercel), configure as variáveis em:
#    Settings → Environment Variables
#
# ═══════════════════════════════════════════════════════════════════════


# ------------------------------------------------------------------------------
# SEGURANCA / PRODUCAO
# ------------------------------------------------------------------------------
# Dominio oficial da instalacao. Use o dominio da Vercel ou dominio proprio.
# Exemplo: https://jurismonitor-cliente.vercel.app
APP_ORIGIN=https://seu-site.vercel.app

# Segredo administrativo para rotas sensiveis, como criar usuario de portal
# e liberar diagnosticos em producao quando necessario.
# Gere um valor longo e aleatorio para cada cliente/instalacao.
ADMIN_API_SECRET=troque-por-um-segredo-longo-e-unico

# Em producao, deixe false. Use true apenas temporariamente para suporte.
ENABLE_DEBUG_ENDPOINTS=false
